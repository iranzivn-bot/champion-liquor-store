# ─── VCS ────────────────────────────────────────────────────────────────
.git
.gitignore

# ─── Secrets ────────────────────────────────────────────────────────────
.env
.env.*
!*.env.example

# ─── Dependencies & build ───────────────────────────────────────────────
node_modules/
vendor/
composer.lock
package-lock.json
dist/

# ─── Local runtime data (not needed in the image — keep dir structure) ──
backups/*
!backups/**/.gitkeep
storage/logs/*
!storage/logs/**/.gitkeep
storage/cache/*
!storage/cache/**/.gitkeep
storage/sessions/*
!storage/sessions/**/.gitkeep
storage/exports/*
!storage/exports/**/.gitkeep
storage/tmp/*
!storage/tmp/**/.gitkeep
storage/framework/maintenance.lock
uploads/*
!uploads/**/.gitkeep

# ─── IDE & OS ───────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db